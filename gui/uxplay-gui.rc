// Windows resources for uxplay-gui.exe: application icon (used by Explorer,
// shortcuts, the taskbar, Alt+Tab, the title bar and the tray) and version info.
#include <winver.h>
#include "resource.h"

#ifndef UXPLAY_VER_MAJOR
#define UXPLAY_VER_MAJOR 0
#define UXPLAY_VER_MINOR 0
#define UXPLAY_VER_PATCH 0
#endif
// Version string built from the numeric parts (string defines do not survive
// the resource compiler's command line reliably).
#define UXPLAY_STR2(x) #x
#define UXPLAY_STR(x)  UXPLAY_STR2(x)
#define UXPLAY_VER_STRING UXPLAY_STR(UXPLAY_VER_MAJOR.UXPLAY_VER_MINOR.UXPLAY_VER_PATCH)

IDI_UXPLAY ICON "uxplay.ico"

// Common Controls v6 for the Bonjour setup task dialog (see bonjour_win.cpp)
2 24 "comctl6.manifest"

1 VERSIONINFO
FILEVERSION     UXPLAY_VER_MAJOR, UXPLAY_VER_MINOR, UXPLAY_VER_PATCH, 0
PRODUCTVERSION  UXPLAY_VER_MAJOR, UXPLAY_VER_MINOR, UXPLAY_VER_PATCH, 0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "UxPlay Contributors"
      VALUE "FileDescription",  "UxPlay"
      VALUE "FileVersion",      UXPLAY_VER_STRING
      VALUE "InternalName",     "uxplay-gui"
      VALUE "LegalCopyright",   "GNU GPL v3"
      VALUE "OriginalFilename", "uxplay-gui.exe"
      VALUE "ProductName",      "UxPlay"
      VALUE "ProductVersion",   UXPLAY_VER_STRING
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
